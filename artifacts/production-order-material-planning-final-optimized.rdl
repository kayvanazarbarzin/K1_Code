        <Field Name="مقدار_کل_سفارش"><DataField>مقدار کل سفارش</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="مقدار_مبنای_نیازسنجی"><DataField>مقدار مبنای نیازسنجی</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="لایه_BOM"><DataField>لایه BOM</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="کد_کالا"><DataField>کد کالا</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="نام_کالا"><DataField>نام کالا</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="واحد_سنجش"><DataField>واحد سنجش</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ماهیت_کالا"><DataField>ماهیت کالا</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="گروه_و_اولویت_جایگزینی"><DataField>گروه و اولویت جایگزینی</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="نیاز_معادل_عضو"><DataField>نیاز معادل عضو</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="موجودی_انبار"><DataField>موجودی انبار</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="سفارش_های_تولید_باز"><DataField>سفارش‌های تولید باز</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="سفارش_خرید_در_راه"><DataField>سفارش خرید در راه</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="تامین_از_موجودی"><DataField>تامین از موجودی</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="تامین_از_سفارش_تولید_باز"><DataField>تامین از سفارش تولید باز</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="تامین_از_سفارش_خرید"><DataField>تامین از سفارش خرید</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="تخصیص_تجمعی_پیش_از_ردیف"><DataField>تخصیص تجمعی پیش از ردیف</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="تخصیص_جاری"><DataField>تخصیص جاری</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="کسری_نهایی"><DataField>کسری نهایی</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="اقدام_موردنیاز"><DataField>اقدام موردنیاز</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
